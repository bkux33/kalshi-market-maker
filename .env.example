# Copy to .env (never commit .env). Secrets are read ONLY from the environment.

# paper (default) | live. Live is refused unless every gate in RISK.md passes.
TRADING_MODE=paper
# Required, exactly this value, in addition to TRADING_MODE=live:
# LIVE_TRADING_ACK=I_ACCEPT_REAL_MONEY_RISK

# demo | prod  (use demo first; demo is fake money). With demo, the app refuses non-demo URLs.
KALSHI_ENV=demo
# external (recommended hosts: external-api.demo.kalshi.co / external-api-ws.demo.kalshi.co) | legacy (demo-api.kalshi.co)
# KALSHI_HOST_PROFILE=external
# Optional explicit overrides:
# KALSHI_REST_URL=https://external-api.demo.kalshi.co/trade-api/v2
# KALSHI_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2
# Required for the WebSocket feed (Kalshi authenticates even public channels) and for orders.
KALSHI_API_KEY_ID=
# Path to the RSA private key PEM downloaded from Kalshi. Keep it outside the repo, chmod 600.
KALSHI_PRIVATE_KEY_PATH=/secrets/kalshi.pem

# Where tape, journals, DuckDB, state files and the kill switch live.
DATA_DIR=./data
# Optional YAML config (see config/alphalab.example.yaml)
# ALPHALAB_CONFIG=config/alphalab.yaml
# Optional: override the kill-switch file path
# KILL_SWITCH_FILE=./data/KILL_SWITCH

# Optional dashboard bearer token (strongly recommended if you bind to anything but 127.0.0.1)
# DASHBOARD_TOKEN=

# Optional LLM research assistant (read-only). Both must be set to enable it.
# ANTHROPIC_API_KEY=
# ALPHALAB_LLM=1
